# ---------------------------------------------------------------------------
# Nym API environment
# Copy to .env and fill in. Every value is validated at boot (src/config).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# The Angular app. CORS allows this origin with credentials, and the OIDC
# callback redirects here once a session exists.
WEB_ORIGIN=http://localhost:4200
WEB_APP_URL=http://localhost:4200

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://nym:nym@localhost:5432/nym
DATABASE_SSL=false
# Verify the DB TLS certificate when DATABASE_SSL=true. Leave true; set false
# only as a local break-glass for self-signed hosts (refused in production).
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Leave false: migrations are the supported path to change the schema.
# Refused in production even if set true.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# --- Anthropic -------------------------------------------------------------
# Generation calls the Claude API directly; there is no offline fallback.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=3000
ANTHROPIC_TIMEOUT_MS=120000
ANTHROPIC_MAX_RETRIES=2

# --- OIDC / SSO ------------------------------------------------------------
# Standards-based discovery: works with Entra ID, Okta, Auth0 or Keycloak.
# Examples:
#   Entra ID  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Okta      https://<org>.okta.com/oauth2/default
#   Auth0     https://<tenant>.eu.auth0.com/
#   Keycloak  https://<host>/realms/<realm>
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match an allow-listed redirect URI on the IdP. The callback builds the
# code-exchange URL from this value — never from Host / X-Forwarded-* headers.
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_SCOPES=openid profile email

# Claim names vary per provider; map them here rather than in code.
OIDC_NAME_CLAIM=name
OIDC_EMAIL_CLAIM=email
OIDC_ROLE_CLAIM=role
OIDC_DEFAULT_ROLE=Publishing assistant
# Comma-separated IdP role values allowed to delete requests, bulk-approve, and
# rewrite the global prompt. Required in production (empty = nobody). Outside
# production an empty list keeps the local desk open for seeds and tests.
# Prefer also restricting who can sign in at all via an IdP group / app assignment.
OIDC_ADMIN_ROLES=

# --- Session ---------------------------------------------------------------
# Signs the httpOnly session cookie. Minimum 32 characters; rotate per environment.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=nym_session
# JWT and cookie lifetime in seconds (28800 = 8 hours). There is no sign-out; sessions expire.
SESSION_TTL_SECONDS=28800
# Must be true in production (boot refuses otherwise); false only for plain-http local development.
SESSION_COOKIE_SECURE=false
# Express trust-proxy hop count when behind a reverse proxy (e.g. 1 for a single
# TLS terminator). Leave 0 locally so X-Forwarded-* is ignored.
TRUST_PROXY=0

# --- Generation / list limits ---------------------------------------------
# Optional override; defaults to ANTHROPIC_TIMEOUT_MS + 30s.
# GENERATION_STALE_MS=150000
REQUESTS_LIST_DEFAULT_LIMIT=100
REQUESTS_LIST_MAX_LIMIT=200
REQUESTS_APPROVE_ALL_LIMIT=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CREATE=30
RATE_LIMIT_GENERATE=20
RATE_LIMIT_APPROVE_ALL=5
